{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dai.studio/schema/extensions/pattern.schema.json",
  "title": "Pattern metadata (patterns/<category>/<leaf>.yaml, next to <leaf>.dai)",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "description", "version"],
  "properties": {
    "name": { "type": "string", "minLength": 1, "maxLength": 60 },
    "description": { "type": "string", "minLength": 1, "maxLength": 500 },
    "version": { "type": "string", "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$" },
    "aliases": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9-]{1,64}$" }
    },
    "deprecated": { "type": "boolean" }
  }
}
