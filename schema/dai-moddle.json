    {
      "name": "ParallelGatewayExtension",
      "isAbstract": true,
      "extends": ["bpmn:ParallelGateway"],
      "properties": [
        { "name": "notes", "isAttr": true, "type": "String" }
      ]
    },
    {
      "name": "DataStoreReferenceExtension",
      "isAbstract": true,
      "extends": ["bpmn:DataStoreReference"],
      "properties": [
        { "name": "notes", "isAttr": true, "type": "String" }
      ]
    },
    {
      "name": "WorkflowMeta",
      "superClass": ["Element"],
      "meta": {
        "allowedIn": ["bpmn:Process", "bpmn:Collaboration"]
      },
      "properties": [
        { "name": "description", "isAttr": true, "type": "String" },
        { "name": "defaultModel", "isAttr": true, "type": "String" },
        { "name": "targetLanguage", "isAttr": true, "type": "String" },
        { "name": "targetFramework", "isAttr": true, "type": "String" },
        { "name": "version", "isAttr": true, "type": "String" },
        { "name": "taskTypeEntries", "isMany": true, "type": "dai:TaskTypeEntry" }
      ]
    },
    {
      "name": "TaskTypeEntry",
      "superClass": ["Element"],
      "properties": [
        { "name": "type",        "isAttr": true, "type": "String" },
        { "name": "stepType",    "isAttr": true, "type": "String" },
        { "name": "description", "isAttr": true, "type": "String" }
      ]
    },
    {
      "name": "AiTask",
      "superClass": ["Element"],
      "meta": {
        "allowedIn": ["bpmn:ServiceTask", "bpmn:Task"]
      },
      "properties": [
        { "name": "stepType", "isAttr": true, "type": "String", "default": "ai" },
        { "name": "model", "isAttr": true, "type": "String" },
        { "name": "temperature", "isAttr": true, "type": "String" },
        { "name": "maxTokens", "isAttr": true, "type": "Integer" },
        { "name": "outputFormat", "isAttr": true, "type": "String" },
        { "name": "prompt", "type": "dai:Prompt" },
        { "name": "outputSchema", "type": "dai:OutputSchema" }
      ]
    },
    {
      "name": "Prompt",
      "superClass": ["Element"],
      "meta": {
        "allowedIn": ["dai:AiTask"]
      },
      "properties": [
        { "name": "value", "isBody": true, "type": "String" }
      ]
    },
    {
      "name": "OutputSchema",
      "superClass": ["Element"],
      "meta": {
        "allowedIn": ["dai:AiTask"]
      },
      "properties": [
        { "name": "value", "isBody": true, "type": "String" }
      ]
    },
    {
      "name": "HumanReview",
      "superClass": ["Element"],
      "meta": {
        "allowedIn": ["bpmn:UserTask"]
      },
      "properties": [
        { "name": "instructions", "isAttr": true, "type": "String" },
        { "name": "approveLabel", "isAttr": true, "type": "String" },
        { "name": "rejectLabel", "isAttr": true, "type": "String" }
      ]
    },
    {
      "name": "Validation",
      "superClass": ["Element"],
      "meta": {
        "allowedIn": ["bpmn:BusinessRuleTask"]
      },
      "properties": [
        { "name": "validationType", "isAttr": true, "type": "String" },
        { "name": "rules", "isAttr": true, "type": "String" },
        { "name": "failBehavior", "isAttr": true, "type": "String" }
      ]
    },
    {
      "name": "ToolExecution",
      "superClass": ["Element"],
      "meta": {
        "allowedIn": ["bpmn:ServiceTask", "bpmn:ScriptTask"]
      },
      "properties": [
        { "name": "toolType", "isAttr": true, "type": "String" },
        { "name": "command", "isAttr": true, "type": "String" },
        { "name": "args", "isAttr": true, "type": "String" },
        { "name": "workingDir", "isAttr": true, "type": "String" }
      ]
    },
    {
      "name": "ConditionLabel",
      "superClass": ["Element"],
      "meta": {
        "allowedIn": ["bpmn:SequenceFlow"]
      },
      "properties": [
        { "name": "label", "isAttr": true, "type": "String" },
        { "name": "expression", "isAttr": true, "type": "String" }
      ]
    },
    {
      "name": "Property",
      "superClass": ["Element"],
      "properties": [
        { "name": "name", "isAttr": true, "type": "String" },
        { "name": "type", "isAttr": true, "type": "String" }
      ]
    },
    {
      "name": "Properties",
      "superClass": ["Element"],
      "meta": {
        "allowedIn": ["bpmn:Task", "bpmn:SubProcess"]
      },
      "properties": [
        { "name": "values", "isMany": true, "type": "dai:Property" }
      ]
    }
  ]
}
