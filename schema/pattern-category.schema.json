{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dai.studio/schema/extensions/pattern-category.schema.json",
  "title": "Pattern category (patterns/<category>/_category.yaml)",
  "type": "object",
  "additionalProperties": false,
  "required": ["label", "order", "color"],
  "properties": {
    "label": { "type": "string", "minLength": 1, "maxLength": 40 },
    "order": { "type": "integer", "minimum": 0, "maximum": 10000 },
    "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{3,8}$" },
    "iconType": { "type": "string", "pattern": "^dai\\.types\\.[a-z0-9-]+\\.[a-z0-9-]+$" }
  }
}
