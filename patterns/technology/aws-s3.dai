<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  xmlns:dai="https://dai.studio/schema/dai/1.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  id="Definitions_awss3"
  name="AWS S3 pattern"
  targetNamespace="https://dai.studio/workflow">

  <bpmn:process id="Process_awss3" name="AWS S3" isExecutable="false">

    <bpmn:task id="Task_awss3_create" name="Create Bucket"
      dai:type="dai.types.software.component" dai:stepType="component" dai:componentType="infra"
      dai:notes="Create an S3 bucket with versioning enabled and default (SSE-S3) server-side encryption. Choose a globally-unique bucket name and the target AWS region." />

    <bpmn:task id="Task_awss3_upload" name="Upload Object"
      dai:type="dai.types.software.component" dai:stepType="component" dai:componentType="infra"
      dai:notes="Upload an object to the bucket, setting the correct Content-Type and any required metadata or tags." />

    <bpmn:task id="Task_awss3_policy" name="Set Policy"
      dai:type="dai.types.software.component" dai:stepType="component" dai:componentType="infra"
      dai:notes="Attach a bucket policy that grants least-privilege access — restrict to the principals and actions actually required (e.g. a specific IAM role for GetObject) and block public access unless the bucket is intentionally public." />

    <bpmn:sequenceFlow id="Flow_awss3_1" sourceRef="Task_awss3_create" targetRef="Task_awss3_upload" />
    <bpmn:sequenceFlow id="Flow_awss3_2" sourceRef="Task_awss3_upload" targetRef="Task_awss3_policy" />

  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_awss3">
    <bpmndi:BPMNPlane id="BPMNPlane_awss3" bpmnElement="Process_awss3">

      <bpmndi:BPMNShape id="Task_awss3_create_di" bpmnElement="Task_awss3_create">
        <dc:Bounds x="0" y="0" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_awss3_upload_di" bpmnElement="Task_awss3_upload">
        <dc:Bounds x="180" y="0" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_awss3_policy_di" bpmnElement="Task_awss3_policy">
        <dc:Bounds x="360" y="0" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_awss3_1_di" bpmnElement="Flow_awss3_1">
        <di:waypoint x="100" y="40" />
        <di:waypoint x="180" y="40" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_awss3_2_di" bpmnElement="Flow_awss3_2">
        <di:waypoint x="280" y="40" />
        <di:waypoint x="360" y="40" />
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</bpmn:definitions>
