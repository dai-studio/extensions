<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  xmlns:dai="https://dai.studio/schema/dai/1.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  id="Definitions_azureblob"
  name="Azure Blob Storage pattern"
  targetNamespace="https://dai.studio/workflow">

  <bpmn:process id="Process_azureblob" name="Azure Blob Storage" isExecutable="false">

    <bpmn:task id="Task_azureblob_create" name="Create Storage Account"
      dai:type="dai.types.azure.storage-account"
      dai:notes="Create a StorageV2 account with a globally-unique name (3–24 lowercase letters and numbers) in the target region. Pick redundancy (ZRS or GZRS for production), disable anonymous blob access and shared key authorization, then create a private container." />

    <bpmn:task id="Task_azureblob_upload" name="Upload Blob"
      dai:type="dai.types.software.component" dai:stepType="component" dai:componentType="infra"
      dai:notes="Upload a blob to the container, setting the correct Content-Type, access tier and any required metadata or index tags." />

    <bpmn:task id="Task_azureblob_access" name="Grant Access"
      dai:type="dai.types.software.component" dai:stepType="component" dai:componentType="infra"
      dai:notes="Grant least-privilege access with Azure RBAC — assign Storage Blob Data Reader (or Contributor) scoped to the container, preferably to a managed identity. Avoid account keys and long-lived SAS tokens; use a private endpoint unless the data is intentionally public." />

    <bpmn:sequenceFlow id="Flow_azureblob_1" sourceRef="Task_azureblob_create" targetRef="Task_azureblob_upload" />
    <bpmn:sequenceFlow id="Flow_azureblob_2" sourceRef="Task_azureblob_upload" targetRef="Task_azureblob_access" />

  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_azureblob">
    <bpmndi:BPMNPlane id="BPMNPlane_azureblob" bpmnElement="Process_azureblob">

      <bpmndi:BPMNShape id="Task_azureblob_create_di" bpmnElement="Task_azureblob_create">
        <dc:Bounds x="0" y="0" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_azureblob_upload_di" bpmnElement="Task_azureblob_upload">
        <dc:Bounds x="180" y="0" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_azureblob_access_di" bpmnElement="Task_azureblob_access">
        <dc:Bounds x="360" y="0" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_azureblob_1_di" bpmnElement="Flow_azureblob_1">
        <di:waypoint x="100" y="40" />
        <di:waypoint x="180" y="40" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_azureblob_2_di" bpmnElement="Flow_azureblob_2">
        <di:waypoint x="280" y="40" />
        <di:waypoint x="360" y="40" />
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</bpmn:definitions>
