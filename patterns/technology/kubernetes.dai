<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  xmlns:dai="https://dai.studio/schema/dai/1.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  id="Definitions_k8s"
  name="Kubernetes pattern"
  targetNamespace="https://dai.studio/workflow">

  <bpmn:process id="Process_k8s" name="Kubernetes" isExecutable="false">

    <bpmn:task id="Task_k8s_deployment" name="Create Deployment"
      dai:type="dai.types.software.component" dai:stepType="component" dai:componentType="infra"
      dai:notes="Define a Deployment manifest — container image, replica count, resource requests/limits, and readiness/liveness probes. Apply it to the target namespace." />

    <bpmn:task id="Task_k8s_service" name="Expose Service"
      dai:type="dai.types.software.component" dai:stepType="component" dai:componentType="infra"
      dai:notes="Create a Service that selects the Deployment's pods and exposes the required port. Choose ClusterIP, NodePort, or LoadBalancer depending on how the workload should be reached." />

    <bpmn:sequenceFlow id="Flow_k8s_1" sourceRef="Task_k8s_deployment" targetRef="Task_k8s_service" />

  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_k8s">
    <bpmndi:BPMNPlane id="BPMNPlane_k8s" bpmnElement="Process_k8s">

      <bpmndi:BPMNShape id="Task_k8s_deployment_di" bpmnElement="Task_k8s_deployment">
        <dc:Bounds x="0" y="0" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_k8s_service_di" bpmnElement="Task_k8s_service">
        <dc:Bounds x="180" y="0" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_k8s_1_di" bpmnElement="Flow_k8s_1">
        <di:waypoint x="100" y="40" />
        <di:waypoint x="180" y="40" />
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</bpmn:definitions>
